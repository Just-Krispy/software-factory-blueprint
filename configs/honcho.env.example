# Honcho server configuration — annotated reference
#
# Copy to ~/honcho-memory/.env and fill in. Nothing here is secret except the API
# keys; never commit the filled-in file.
#
# Models are addressed as: <transport> + <model> + optional <base_url>.
# The "openai" transport means ANY OpenAI-compatible endpoint: OpenAI itself,
# OpenRouter, vLLM, LM Studio, an MLX server.

# ── database ────────────────────────────────────────────────────────────────
# The compose file supplies DB_CONNECTION_URI pointing at the `database`
# service; leave unset unless Postgres runs elsewhere.
# DB_CONNECTION_URI=postgresql+psycopg://honcho:<pw>@database:5432/honcho

# ── auth ────────────────────────────────────────────────────────────────────
# OFF means the API accepts any key, including none.
AUTH_USE_AUTH=false
# Required when AUTH_USE_AUTH=true. Generate with:
#   uv run python scripts/generate_jwt_secret.py
# AUTH_JWT_SECRET=

# ── provider keys ───────────────────────────────────────────────────────────
LLM_OPENAI_API_KEY=<your key>
# LLM_OPENAI_BASE_URL=https://openrouter.ai/api/v1   # OpenRouter / vLLM / MLX
# LLM_ANTHROPIC_API_KEY=
# LLM_GEMINI_API_KEY=

# ── log ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_ENABLED=false

# ── embeddings ──────────────────────────────────────────────────────────────
# These default to api.openai.com with NO base URL. If your chat traffic uses a
# different provider, set the base URL here too or search/dedup 401s.
# Two valid combinations — do not mix them:
#   OpenAI direct:  bare model id, no base URL
#   OpenRouter etc: prefixed id AND the base URL (set it explicitly; the model
#                   prefix is only stripped automatically when transport is unset)
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=text-embedding-3-small
# EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL_CONFIG__MODEL=openai/text-embedding-3-small
# EMBEDDING_VECTOR_DIMENSIONS=1536            # must match the embedding model
EMBED_MESSAGES=false               # true = also embed message bodies

# ── deriver (message -> observations/conclusions) ───────────────────────────
DERIVER_ENABLED=true
DERIVER_WORKERS=1
# true = process each work unit immediately (testing).
# false = batch until the token target or the 30-minute age-out. Cheaper.
DERIVER_FLUSH_ENABLED=true
# DERIVER_REPRESENTATION_BATCH_MAX_AGE_SECONDS=1800
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=<provider/model>
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DERIVER_MODEL_CONFIG__THINKING_EFFORT=minimal

# ── summaries ───────────────────────────────────────────────────────────────
SUMMARY_ENABLED=true
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=<provider/model>
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
SUMMARY_MODEL_CONFIG__THINKING_EFFORT=minimal

# ── dialectic (the "ask the memory" endpoint) ───────────────────────────────
# All five levels must use a model id valid for the base URL above. Mixing a
# local slug with a remote base URL breaks every chat call with a 400.
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=<provider/model>
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__minimal__MAX_TOOL_ITERATIONS=1
DIALECTIC_LEVELS__minimal__MAX_OUTPUT_TOKENS=250
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=<provider/model>
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__low__MAX_TOOL_ITERATIONS=3
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=<provider/model>
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__medium__MAX_TOOL_ITERATIONS=3
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=<provider/model>
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__high__MAX_TOOL_ITERATIONS=4
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=<provider/model>
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__max__MAX_TOOL_ITERATIONS=5

# ── dream (expensive inductive pass) ────────────────────────────────────────
# NOTE: the code default is TRUE — this line is what keeps it off on a first
# install. Removing it silently re-enables the expensive inductive pass.
DREAM_ENABLED=false
