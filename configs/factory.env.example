# Factory environment template
#
# Copy to the factory repo root as `.env`. The justfile loads it automatically
# (`set dotenv-load`), so every ADW script sees these without exporting.
#
# WHICH KEYS YOU NEED DEPENDS ON YOUR ROSTER.
# Every `model:` in adws/adw_sssf_config/sssf.config.yaml is written as
# provider/model-id. The provider half decides which key must be set.
# Pointing every agent at one provider means you only need that provider's key
# (set `defaults.model` and drop the per-agent `model:` overrides).
#
# Nothing validates this at startup: a missing key shows up when that agent runs,
# not when the workflow starts.

# ── provider keys ───────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# FIREWORKS_API_KEY=

# ── engine ──────────────────────────────────────────────────────────────────
# PI_PATH=pi                        # agent binary if not on PATH
# ENGINEER_NAME=                    # lane label; defaults to git user.name

# ── memory endpoints (read by the agents and the bridge, not the engine) ────
HONCHO_ENVIRONMENT_URL=http://127.0.0.1:8000
HONCHO_API_KEY=                     # only meaningful when AUTH_USE_AUTH=true

# ── monitor (optional; read-only remote inspection) ─────────────────────────
# FFM_HOST=<ssh-alias>
# FFM_HONCHO_URL=http://127.0.0.1:8000
# FFM_WORKSPACE=factory-brain
