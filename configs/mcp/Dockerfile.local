# Local build for the Honcho MCP worker.
#
# The upstream repo ships a Cloudflare-Worker config (wrangler.toml) but no plain
# Dockerfile — a local compose `mcp` service has nothing to build without this.
# `npm pkg delete scripts.preinstall` drops upstream's "use bun, not npm" guard,
# which would otherwise fail the image build.
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json ./
RUN npm pkg delete scripts.preinstall \
    && npm install --legacy-peer-deps \
    && npm install --legacy-peer-deps ai

COPY src ./src
COPY wrangler.toml wrangler.local.toml ./

EXPOSE 8790
